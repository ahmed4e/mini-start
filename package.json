{
  "name": "mini-start-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node packages/create-mini-start/src/cli.ts --ui --port 5173",
    "build:ui": "pnpm --filter create-mini-start build:ui",
    "demo": "pnpm --filter demo dev --port 5180",
    "demo:build": "pnpm --filter demo build",
    "demo:start": "pnpm --filter demo preview",
    "demo:sync": "node packages/create-mini-start/scripts/sync-demo.ts && pnpm install",
    "test:demo": "pnpm --filter demo test",
    "create-app": "node packages/create-mini-start/src/cli.ts",
    "typecheck": "pnpm -r typecheck",
    "test": "node --test 'packages/*/test/*.test.ts'"
  },
  "packageManager": "pnpm@11.15.0"
}
